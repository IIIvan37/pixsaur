#!/bin/sh

# Ensure Node version from .nvmrc (strict) and pnpm via Corepack
if [ -z "$NVM_DIR" ]; then
  export NVM_DIR="$HOME/.nvm"
fi
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use 24.11.0 >/dev/null 2>&1 || true
fi

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v corepack >/dev/null 2>&1; then
    corepack enable >/dev/null 2>&1 || true
    corepack prepare pnpm@10.11.0 --activate >/dev/null 2>&1 || true
  fi
fi

# typecheck:comprehensive already builds tsconfig.app.json and
# tsconfig.node.json with stricter flags, so a separate `tsc -b` would be a
# third full pass for nothing.
echo "🔍 Running comprehensive TypeScript check - takes longer..."
pnpm -s typecheck:comprehensive

echo "🔍 Running biome checks..."
# Format only what is actually being committed. `biome check . --write`
# followed by `git add -u` used to stage EVERY modified tracked file, which
# silently widened commits and defeated `git add -p`.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z |
  tr '\0' '\n' | grep -E '\.(js|jsx|ts|tsx|json|css)$' || true)

if [ -z "$staged" ]; then
  echo "   (no js/ts/json/css file staged — skipped)"
else
  # A file that is staged AND dirty in the worktree cannot be formatted
  # safely: writing to it would either drag the unstaged hunks into the
  # commit or leave unformatted content in it. Refuse instead of guessing.
  partial=$(printf '%s\n' "$staged" | while IFS= read -r f; do
    git diff --quiet -- "$f" || printf '%s\n' "$f"
  done)

  if [ -n "$partial" ]; then
    echo "❌ Staged files that also have unstaged changes:"
    printf '%s\n' "$partial" | sed 's/^/   /'
    echo "   Stage them fully (git add <file>) or stash the rest, then retry."
    exit 1
  fi

  printf '%s\n' "$staged" | tr '\n' '\0' |
    xargs -0 npx @biomejs/biome check --write
  # Re-stage ONLY the files biome may have rewritten — never `git add -u`.
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add
fi

echo "🔍 Running react-doctor on the staged files..."
# Staged scope, not branch scope: the hook asks "what am I about to commit",
# which is also what keeps it under a second. The branch-wide question belongs
# to `pnpm gate` in CI. Skipped when nothing React-ish is staged.
if [ -z "$staged" ]; then
  echo "   (no js/ts/json/css file staged — skipped)"
else
  # Explicit `|| exit 1`: this hook runs without `set -e`, so a failing check in
  # the middle would otherwise be reported and then ignored, the script exiting
  # 0 on its last echo.
  pnpm -s check:react:staged || exit 1
fi

echo "🔍 Running console usage check..."
node scripts/check-console-usage.js

echo "🔍 Checking forbidden Radix imports..."
node scripts/check-radix-imports.js
node scripts/check-tauri-imports.js

echo "🔍 Checking layer imports..."
node scripts/check-layer-imports.js

echo "✅ Pre-commit checks passed!"
