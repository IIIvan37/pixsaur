{
  "name": "pixsaur",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.11.0"
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:mutation": "stryker run",
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "typecheck:comprehensive": "node scripts/typecheck-comprehensive.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check . && node scripts/check-console-usage.js && node scripts/check-radix-imports.js && node scripts/check-tauri-imports.js && node scripts/check-layer-imports.js",
    "check:fix": "biome check . --write",
    "check:radix-imports": "node scripts/check-radix-imports.js",
    "check:tauri-imports": "node scripts/check-tauri-imports.js",
    "check:arch": "sheriff verify src/main.tsx || true",
    "check:react": "node scripts/check-react-doctor.js src",
    "check:react:full": "react-doctor src --no-telemetry",
    "check:design": "impeccable detect src || true",
    "check:dead": "knip",
    "check:dup": "jscpd src",
    "gate": "pnpm run \"/^(typecheck|typecheck:comprehensive|check|check:arch|check:react|check:design|check:dup|test:coverage)$/\"",
    "refactor:preflight": "tsc --noEmit && knip --no-exit-code && jscpd src",
    "preview": "vite preview",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "asm:expand": "node scripts/expand-asm-includes.cjs",
    "prepare": "husky",
    "setup": "corepack enable && corepack prepare pnpm@10.11.0 --activate"
  },
  "dependencies": {
    "@lingui/core": "^5.5.1",
    "@lingui/react": "^5.5.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "clsx": "^2.1.1",
    "jotai": "^2.12.4",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "regl": "^2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@lingui/cli": "^5.5.1",
    "@lingui/vite-plugin": "^5.5.1",
    "@netlify/functions": "^5.0.1",
    "@softarc/sheriff-core": "^0.19.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.13",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.4",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "babel-plugin-macros": "^3.1.0",
    "husky": "^9.1.7",
    "impeccable": "^3.2.0",
    "jscpd": "^5.0.6",
    "knip": "^6.16.1",
    "netlify-cli": "^23.9.5",
    "react-doctor": "^0.7.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vitest": "^4.0.4"
  },
  "packageManager": "pnpm@10.11.0"
}
