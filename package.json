    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "clsx": "^2.1.1",
    "jotai": "^2.12.4",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "marked": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
