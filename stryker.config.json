{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domain/cpc/**/*.ts",
    "src/libs/pixsaur-color/src/histogram/**/*.ts",
    "src/libs/pixsaur-color/src/space/**/*.ts",
    "src/libs/pixsaur-color/src/utils/**/*.ts",
    "src/libs/pixsaur-color/src/metric/**/*.ts",
    "src/preview/application/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/index.ts",
    "!src/domain/cpc/mode-config.ts",
    "!src/domain/cpc/cpc-palette.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 72
  },
  "ignorePatterns": ["src-tauri", "src/libs/rasm-wasm", "dist"],
  "tempDirName": ".stryker-tmp",
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
